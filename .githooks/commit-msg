#!/bin/sh
# Enforces "part: short desc" subjects of at most 80 characters.
file="$1"
subject=$(head -n 1 "$file")

case "$subject" in
    Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(core|bots|net|cli|gui|build|docs|test): .+'; then
    echo "commit-msg: subject must look like 'part: short desc'" >&2
    echo "  parts: core, bots, net, cli, gui, build, docs, test" >&2
    exit 1
fi

if [ "${#subject}" -gt 80 ]; then
    echo "commit-msg: subject is ${#subject} chars, the limit is 80" >&2
    exit 1
fi
